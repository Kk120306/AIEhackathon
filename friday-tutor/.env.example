# Copy to .env.local (gitignored). Vertex AI + Application Default Credentials required.

# Required: GCP project ID for Vertex (see lib/gemini.ts)
GOOGLE_CLOUD_PROJECT=

# Optional: defaults to "global" in code
# GOOGLE_CLOUD_LOCATION=global

# Optional model overrides
# GEMINI_CHAT_MODEL=gemini-1.5-flash-8b
# GEMINI_TRANSCRIPTION_MODEL=gemini-1.5-flash-8b

# Optional: ElevenLabs for /api/speak and /api/voices
# ELEVENLABS_API_KEY=
# ELEVENLABS_DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Optional: Imagen / portrait (see lib/generateImage.ts, lib/teacherPortrait.ts)
# IMAGEN_MODEL=imagen-4.0-generate-001
# TEACHER_PORTRAIT_IMAGEN_MODEL=imagen-4.0-generate-001

# Optional: video generation (see lib/generateVideo.ts)
# GEMINI_VIDEO_MODEL=veo-3.1-fast-generate-preview
# GEMINI_VIDEO_POLL_MS=10000
# GEMINI_VIDEO_MAX_POLLS=36

# If not using gcloud user ADC, point at a service account JSON:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/key.json
