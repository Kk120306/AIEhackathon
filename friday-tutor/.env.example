# Copy this file to .env.local and fill in the values.
# .env.local is gitignored and will never be committed.

# Required: Gemini API key — get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...

# Optional: override the models used (defaults shown)
# GEMINI_CHAT_MODEL=gemini-2.5-flash-lite
# GEMINI_TRANSCRIPTION_MODEL=gemini-2.5-flash-lite

# Optional: Imagen model for illustrations and the on-screen tutor portrait (see lib/generateImage.ts, lib/teacherPortrait.ts)
# IMAGEN_MODEL=imagen-4.0-generate-001
# TEACHER_PORTRAIT_IMAGEN_MODEL=imagen-4.0-generate-001
