# Copy this file to .env.local and fill in the values.
# .env.local is gitignored and will never be committed.

# Required: Gemini API key — get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...

# Optional: override the models used (defaults shown)
# GEMINI_CHAT_MODEL=gemini-2.0-flash
# GEMINI_TRANSCRIPTION_MODEL=gemini-2.0-flash

# Convex (parents dashboard) — run `npx convex dev` in friday-tutor/ to get these values
# CONVEX_DEPLOYMENT=dev:your-deployment-name
# NEXT_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud
